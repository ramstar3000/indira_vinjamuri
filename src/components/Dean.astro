---
const base = import.meta.env.BASE_URL;

const pillarsData = [
  {
    key: 'train-to-gain',
    icon: 'I',
    title: 'Train to Gain',
    summary: 'Excellence and consistency in training that lifts standards across the board',
    subtitle: 'Excellence & Consistency in Training',
    body: `<p>Every resident doctor, wherever they train, deserves fair, high-quality education.</p>
      <p><strong>I will deliver on the following:</strong></p>
      <ul>
        <li>Recruitment and retention in psychiatry are current necessary areas. I am already working on Phase 2 of the medical training review and will continue to deliver the best we can.</li>
        <li>A nationally standardised MRCPsych course with consistent expectations. I have been trying to work with MRCPsych leads across the 4 nations to standardise learning and develop exam support.</li>
        <li>Clearer support and structure for supervisors and tutors, to deliver training fit for purpose and understand curricular requirements. I have been working on the College supervision guidance document to make it fit for purpose.</li>
        <li>Integration of neuroscience and psychological formulation as a connected continuum, by improving teaching and supervision structures.</li>
        <li>Equal access to teaching, placements and development for LTFT, rural/remote and IMG resident doctors. I am part of College working groups, and I have written a <a href="${base}/documents/rural-remote-proposal.pdf" target="_blank">proposal for rural/remote run-through training</a>.</li>
      </ul>`,
  },
  {
    key: 'time-to-thrive',
    icon: 'II',
    title: 'Time to Thrive',
    summary: 'Protect educator time, capacity, wellbeing and strengthen recruitment',
    subtitle: 'Protecting Time, Capacity & Consultant Wellbeing',
    body: `<p>Our trainers are the backbone of psychiatry. Their contribution must be recognised, protected and appreciated.</p>
      <p><strong>I will champion:</strong></p>
      <ul>
        <li>The <a href="${base}/documents/rcpsych-bridge-programme.pdf" target="_blank">RCPsych Bridge Programme</a>, supporting the transition from resident doctor to consultant.</li>
        <li>Setting clear expectations for educational roles, with protected time in job plans that allows and promotes training. I am working with the College in understanding this better.</li>
        <li>Stronger boundaries between educational oversight and Trust processes, strengthening recruitment, including developing flexible job plans, adapting dual training to lead to dual clinical practice, e.g. protected sessions for consultants to practice therapy alongside or dual specialty posts.</li>
        <li>Practical steps to reduce burnout and improve consultant wellbeing, and help people understand and engage with the College.</li>
        <li>An opportunity for established consultants with experience and wisdom to contribute to academia. I am writing a <a href="${base}/documents/academia-for-consultants.pdf" target="_blank">proposal paper</a> to sit with the Academic strategy from the College.</li>
      </ul>`,
  },
  {
    key: 'support-to-soar',
    icon: 'III',
    title: 'Support to Soar',
    summary: 'Back educators with tools, recognition and development',
    subtitle: 'Supporting Educators & SAS Doctors Through a Clear College-Led Pathway',
    body: `<p>We must support those who support our resident doctors.</p>
      <p><strong>I will introduce:</strong></p>
      <ul>
        <li>A structured Educator Development Pathway, acknowledged and appreciated in job plans and appraisals.</li>
        <li>Standardised, competency-based training for supervisors, TPDs, tutors and Heads of School, spanning across Foundation, GP and Psychiatry training.</li>
        <li>Enhanced career development and recognition for SAS doctors, train them to train. Work on enhanced portfolio pathways for LED doctors. I am in conversation with portfolio providers regarding this.</li>
        <li>CPD-accredited modules to understand and develop education, and a College-approved educator status.</li>
        <li>Support the wellbeing of residents and trainers and identify local, regional and national pathways for this.</li>
      </ul>`,
  },
  {
    key: 'nourish-to-flourish',
    icon: 'IV',
    title: 'Nourish to Flourish',
    summary: 'Modernise psychiatry with innovative and future-ready practice',
    subtitle: 'Modernising Psychiatry for the Future',
    body: `<p>Our training must evolve with the changing landscape of mental health.</p>
      <p><strong>I will promote:</strong></p>
      <ul>
        <li>Quality recruitment in Psychiatry and work on job satisfaction and retention.</li>
        <li>Digital psychiatry, academic psychiatry, simulation and AI-enabled learning. This becomes a must in our lives. I will aim to bring in regional, national and international expertise to enhance our local learning.</li>
        <li>A holistic model integrating neuroscience, psychological formulation and social determinants, and establish multi-disciplinary team working. I have worked on the PA guidance and MPAC committees.</li>
        <li>Training aligned with community transformation and new service models. Prepare residents for change management. I have been part of GA faculty and participated in preparing for change for years.</li>
        <li>Leadership and management development for residents and early-career consultants, to prevent burnout.</li>
        <li>Academic support and opportunities for experienced consultants who can contribute to the profession.</li>
      </ul>`,
  },
];
---

<section id="dean">
  <div class="container">
    <div class="section-header">
      <h2>Application for Dean</h2>
      <p>My vision for academic and clinical leadership</p>
    </div>

    <div class="dean-content">
      <div class="dean-statement card">
        <h3>Statement of Purpose</h3>

        <div class="dean-pillars">
          <h3>My Four Pillars as Dean</h3>
          <div class="pillar-list">
            {pillarsData.map((pillar) => (
              <div class="pillar-item" data-pillar={pillar.key}>
                <button class="pillar" aria-expanded="false">
                  <div class="pillar-header">
                    <span class="pillar-icon">{pillar.icon}</span>
                    <div class="pillar-title-group">
                      <h4>{pillar.title}</h4>
                      <p>{pillar.summary}</p>
                    </div>
                    <span class="pillar-chevron" aria-hidden="true"></span>
                  </div>
                </button>
                <div class="pillar-detail">
                  <div class="pillar-detail-inner">
                    <p class="pillar-subtitle">{pillar.subtitle}</p>
                    <div class="pillar-body" set:html={pillar.body} />
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <aside class="dean-sidebar">
        <div class="card">
          <h3>Qualifications</h3>
          <ul class="qualifications-list">
            <li>Consultant Psychiatrist</li>
            <li>Director of Medical Education, Mersey Care NHS</li>
            <li>Associate Dean & MRCPsych Lead, RCPsych</li>
            <li>Former GA-SAC Chair, RCPsych</li>
            <li>Hon Senior Lecturer, University of Liverpool</li>
            <li>EPA Ambassador</li>
            <li>GCPN Member, World Health Organisation</li>
            <li>AOMRC Member</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .dean-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .dean-statement h3 {
    margin-bottom: 1rem;
  }

  .dean-pillars {
    margin-top: 2rem;
  }

  .pillar-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* Pillar button */
  .pillar {
    background: var(--color-bg-alt);
    padding: 1.75rem;
    border-radius: var(--border-radius);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    width: 100%;
  }

  .pillar:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .pillar-item.active .pillar {
    border-color: var(--color-accent);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pillar-icon {
    flex-shrink: 0;
    font-family: var(--font-heading);
    font-size: 1.85rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    width: 2.5rem;
    text-align: center;
  }

  .pillar-title-group {
    flex: 1;
    min-width: 0;
  }

  .pillar-title-group h4 {
    font-family: var(--font-heading);
    color: var(--color-accent);
    margin-bottom: 0.3rem;
    font-size: 1.15rem;
  }

  .pillar-title-group p {
    font-size: 0.92rem;
    margin-bottom: 0;
    line-height: 1.4;
    color: var(--color-text-light);
  }

  /* Chevron */
  .pillar-chevron {
    flex-shrink: 0;
    width: 0.65rem;
    height: 0.65rem;
    border-right: 2px solid var(--color-text-light);
    border-bottom: 2px solid var(--color-text-light);
    transform: rotate(45deg);
    transition: transform 0.3s ease;
    margin-left: 0.5rem;
  }

  .pillar-item.active .pillar-chevron {
    transform: rotate(-135deg);
  }

  /* Expandable detail panel */
  .pillar-detail {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }

  .pillar-item.active .pillar-detail {
    grid-template-rows: 1fr;
  }

  .pillar-detail-inner {
    overflow: hidden;
  }

  .pillar-subtitle {
    color: var(--color-text-light);
    font-size: 0.95rem;
    font-style: italic;
    margin-bottom: 0.75rem;
    padding-top: 1.25rem;
  }

  .pillar-body {
    font-size: 0.95rem;
    line-height: 1.7;
    padding-bottom: 0.5rem;
  }

  .pillar-body ul {
    padding-left: 1.25rem;
    margin: 0.75rem 0 0;
  }

  .pillar-body li {
    margin-bottom: 0.6rem;
    color: var(--color-text-light);
  }

  .pillar-body a {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pillar-body a:hover {
    color: var(--color-primary);
  }

  .pillar-body p {
    margin-bottom: 0.5rem;
  }

  /* Qualifications sidebar */
  .qualifications-list {
    list-style: none;
    padding: 0;
  }

  .qualifications-list li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.95rem;
    color: var(--color-text-light);
    position: relative;
    padding-left: 1.25rem;
  }

  .qualifications-list li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .qualifications-list li:last-child {
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .dean-content {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.querySelectorAll('.pillar-item').forEach((item) => {
    const btn = item.querySelector('.pillar');

    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('active');

      // Close all pillars
      document.querySelectorAll('.pillar-item.active').forEach((open) => {
        open.classList.remove('active');
        open.querySelector('.pillar').setAttribute('aria-expanded', 'false');
      });

      // If it wasn't already open, open it
      if (!isOpen) {
        item.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Click anywhere outside a pillar to close
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.pillar-item')) {
      document.querySelectorAll('.pillar-item.active').forEach((open) => {
        open.classList.remove('active');
        open.querySelector('.pillar').setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>
